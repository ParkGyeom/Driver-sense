<?xml version="1.0" encoding="utf-8"?>
<!--
  진단 리포트의 준수율 막대 한 줄.
  막대 길이와 평균선 위치는 layout_weight로 정한다 (코드에서 채움 = 퍼센트, 빈칸 = 100 - 퍼센트).
  막대 색: 주황 = 전국 평균보다 낮음, 파랑 = 평균 이상.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/rowLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/rowCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:textColor="@color/muted"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/rowPercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="44sp"
            android:textStyle="bold" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/rowTrack"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <View
                android:id="@+id/rowFill"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

            <Space
                android:id="@+id/rowRest"
                android:layout_width="0dp"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- 전국 평균선 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <Space
                android:id="@+id/rowAverageBefore"
                android:layout_width="0dp"
                android:layout_height="match_parent" />

            <View
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:background="@color/text" />

            <Space
                android:id="@+id/rowAverageAfter"
                android:layout_width="0dp"
                android:layout_height="match_parent" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
