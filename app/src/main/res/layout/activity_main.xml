<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 뼈대.
  - screenSlot: 지금 보여줄 화면 하나가 들어가는 자리. 지금은 주행 화면(screen_drive)만 있다.
    나중에 기어 P 주행 리포트, 진단 리포트, 습관 선택 화면을 여기서 갈아끼운다.
  - demoPanel: 시연·개발용 패널(panel_demo). debug 빌드에서만 demoToggle로 연다.
    주행 화면 레이아웃과 섞이지 않게 바깥에 둔다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <include
            android:id="@+id/demoPanel"
            layout="@layout/panel_demo"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/screenSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <include
                android:id="@+id/driveScreen"
                layout="@layout/screen_drive" />

            <include layout="@layout/screen_report" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/demoToggle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/demo_open"
        android:textColor="@color/muted"
        android:textSize="20sp"
        android:visibility="gone" />
</FrameLayout>
