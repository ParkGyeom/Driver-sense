<?xml version="1.0" encoding="utf-8"?>
<!--
  내비 위에 잠깐 뜨는 안내 카드. 내비를 덜 가리게 작게, 운전 중 한눈에 읽히게 글자는 크게.
  배경색(주황/파랑)은 코드에서 칠한다. 터치는 받지 않는다 (내비 조작을 막지 않음).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minWidth="560dp"
    android:orientation="horizontal"
    android:paddingStart="28dp"
    android:paddingTop="20dp"
    android:paddingEnd="40dp"
    android:paddingBottom="20dp">

    <ImageView
        android:id="@+id/popupIcon"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_turn_left" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/popupTurn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/on_accent"
            android:textSize="36sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/popupHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:textColor="@color/on_accent"
            android:textSize="56sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- "어떻게 켜는지" 레버 그림. 초보 기능 안내일 때만 보인다. -->
    <kkam.app.LeverGuideView
        android:id="@+id/popupLever"
        android:layout_width="220dp"
        android:layout_height="160dp"
        android:layout_marginStart="24dp"
        android:visibility="gone" />
</LinearLayout>
