<?xml version="1.0" encoding="utf-8"?>
<!--
  화면 뼈대.
  - routeMapPanel: 경로 데모 지도. 주행 화면일 때 screenSlot 왼쪽에 반씩 나눠 보인다.
  - navRail: 기어 P 화면 왼쪽 레일(nav_rail). 리포트·진단·교정 진행·Q&A·모드를 오간다. 주행 화면에서는 숨긴다.
  - screenSlot: 지금 보여줄 화면 하나가 들어가는 자리. 화면마다 담당 클래스(DriveScreen, ReportScreen,
    HabitScreens, ProgressScreen, QnaScreen, ModeScreen)가 자기 화면의 보이기를 정한다.
  - demoPanel: 시연·개발용 패널(panel_demo). debug 빌드에서만 demoToggle로 연다.
    주행 화면 레이아웃과 섞이지 않게 바깥에 둔다.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <include
            android:id="@+id/demoPanel"
            layout="@layout/panel_demo"
            android:layout_width="520dp"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include layout="@layout/nav_rail" />

        <!-- 경로 데모의 앱 안 지도 (RouteMap). 경로가 있고 주행 화면일 때만 보인다. 지도 뷰는 코드에서 넣는다. -->
        <FrameLayout
            android:id="@+id/routeMapPanel"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:background="#99FFFFFF"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:text="@string/route_map_attribution"
                android:textColor="#333333"
                android:textSize="14sp" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/screenSlot"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <include
                android:id="@+id/driveScreen"
                layout="@layout/screen_drive" />

            <include layout="@layout/screen_report" />

            <include layout="@layout/screen_diagnose" />

            <include layout="@layout/screen_habit" />

            <include layout="@layout/screen_progress" />

            <include layout="@layout/screen_qna" />

            <include layout="@layout/screen_mode" />

            <include layout="@layout/screen_route_preview" />

            <include layout="@layout/screen_route_report" />
        </FrameLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/demoToggle"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="28dp"
        android:layout_marginEnd="32dp"
        android:gravity="center"
        android:paddingHorizontal="20dp"
        android:text="@string/demo_open"
        android:textColor="@color/muted"
        android:textSize="20sp"
        android:visibility="gone" />
</FrameLayout>
