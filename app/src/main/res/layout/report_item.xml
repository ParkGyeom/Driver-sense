<?xml version="1.0" encoding="utf-8"?>
<!--
  판정 기록 타임라인의 한 줄.
  왼쪽: 상태 아이콘 동그라미(✓ 파랑 = 지킴, ! 빨강 = 놓침) + 아래로 이어지는 세로선(마지막 줄은 숨김).
  오른쪽: 카드 = 제목, 한 줄 설명, 조항 칩, 처분 칩.
  색·아이콘은 ReportScreen.kt에서 칠한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <!-- 타임라인 축 -->
    <LinearLayout
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/itemIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginTop="20dp"
            android:contentDescription="@null"
            android:padding="14dp" />

        <View
            android:id="@+id/itemLine"
            android:layout_width="4dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/line" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/itemCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/kk_gap"
        android:layout_marginBottom="@dimen/kk_gap"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/kk_gap_large"
        android:paddingVertical="24dp">

        <TextView
            android:id="@+id/itemTitle"
            style="@style/Kk.Body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/itemDetail"
            style="@style/Kk.Caption"
            android:layout_marginTop="4dp" />

        <!-- 조항 칩. 룰 테이블에 없으면 숨긴다. -->
        <TextView
            android:id="@+id/itemArticle"
            style="@style/Kk.Caption"
            android:layout_marginTop="@dimen/kk_gap"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:textColor="@color/text" />

        <!-- 처분 칩. 놓침이면 빨강 계열. -->
        <TextView
            android:id="@+id/itemPenalty"
            style="@style/Kk.Caption"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp" />
    </LinearLayout>
</LinearLayout>
