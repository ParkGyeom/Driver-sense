<?xml version="1.0" encoding="utf-8"?>
<!--
  습관 선택 (기획서 UI-3 뒷부분). 기어 P일 때만 연다.
  위: 제목 + 한 줄 요약, 오른쪽에 "1 / 2개 골랐어요" 진행 표시.
  가운데: 습관 카드 (habit_card.xml을 코드에서 넣는다). 최대 2개.
  아래: 안내 문구(개수 제한에 걸리면 주황), "진단 다시 보기", "선택 완료".
  선택 규칙은 HabitSelection.kt (JVM 테스트 대상).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/habitScreen"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/kk_screen_padding"
    android:visibility="gone">

    <!-- 머리: 제목 + 한 줄 요약 | 진행 표시 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Kk.Title"
                android:text="@string/habit_title" />

            <TextView
                style="@style/Kk.Caption"
                android:layout_marginTop="4dp"
                android:text="@string/habit_hint" />
        </LinearLayout>

        <!-- marginEnd: 오른쪽 위 "데모" 버튼(debug 빌드)과 겹치지 않게 비운다 -->
        <LinearLayout
            android:id="@+id/habitProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="96dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/kk_gap_large"
            android:paddingVertical="@dimen/kk_gap">

            <!-- "1 / 2개": 숫자 크게, 단위 작게 -->
            <TextView
                android:id="@+id/habitCount"
                style="@style/Kk.Title" />

            <TextView
                style="@style/Kk.Caption"
                android:layout_marginStart="12dp"
                android:text="@string/parked_habit_progress_label" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/habitCards"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/kk_gap_large"
        android:layout_weight="1"
        android:orientation="horizontal" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/kk_gap_large"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- "카드를 눌러 고르세요" 또는 "2개까지만 고를 수 있어요" -->
        <TextView
            android:id="@+id/habitNotice"
            style="@style/Kk.Body"
            android:layout_width="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/habitBack"
            style="@style/Kk.Pill"
            android:layout_height="88dp"
            android:layout_marginEnd="20dp"
            android:paddingHorizontal="40dp"
            android:text="@string/habit_back"
            android:textColor="@color/muted"
            android:textSize="@dimen/kk_text_body"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/habitDone"
            style="@style/Kk.Pill"
            android:layout_height="88dp"
            android:paddingHorizontal="48dp"
            android:text="@string/habit_done"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/kk_text_body" />
    </LinearLayout>
</LinearLayout>
