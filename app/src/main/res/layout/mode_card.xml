<?xml version="1.0" encoding="utf-8"?>
<!--
  모드 카드 한 장 (F3). 아이콘, 모드 이름, 대상, 주행 중 안내 한 줄.
  고른 카드는 파란 테두리 + 체크 + 옅은 파란 배경. 배경과 색은 ModeScreen이 칠한다.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="@dimen/kk_gap_large">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/modeIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:importantForAccessibility="no"
            android:padding="18dp" />

        <TextView
            android:id="@+id/modeName"
            style="@style/Kk.Display"
            android:layout_width="0dp"
            android:layout_marginStart="@dimen/kk_gap_large"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/modeCheck"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:gravity="center"
            android:text="@string/mode_check"
            android:textColor="@color/on_accent"
            android:textSize="@dimen/kk_text_body"
            android:textStyle="bold" />
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/modeGuide"
        style="@style/Kk.Body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/modeTarget"
        style="@style/Kk.Caption"
        android:layout_marginTop="4dp" />
</LinearLayout>
