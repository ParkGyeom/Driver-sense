<resources>
    <!-- 데모 패널의 구역 제목. -->
    <style name="DemoHeader">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">20dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- 주행 리포트의 요약 칸. 배경은 코드에서 둥근 모서리로 칠한다. -->
    <style name="ReportTile">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">28dp</item>
    </style>

    <style name="ReportTileLabel">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">26sp</item>
    </style>

    <style name="ReportTileValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">64sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
